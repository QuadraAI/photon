    "welcome.notice.rememberedUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photon couldn’t reopen the folder you used last. It may have been moved, renamed, or be on a drive that isn’t connected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photon n’a pas pu rouvrir le dossier utilisé la dernière fois. Il a peut-être été déplacé ou renommé, ou se trouve sur un disque non connecté."
          }
        }
      }
    },
